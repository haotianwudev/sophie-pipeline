# Txt files
*.txt
# Cloud Run deploy needs this in the repo (GitHub Actions checks out from git, not disk)
!services/spx-options-api/requirements.txt
# Same for the snapshot ETL job. `gcloud run jobs deploy --source` falls back to .gitignore when
# no .gcloudignore exists, so a file ignored here never reaches the build context at all.
!services/spx-snapshot-etl/requirements.txt
# And for the vol-regime job, which uploads its context via `gcloud builds submit` -- same
# .gitignore fallback, same failure mode (COPY of a file that was never uploaded).
!services/vol-regime-etl/requirements.txt

# PDF files
*.pdf

# Node.js
node_modules/

# sophie_agent run records (generated, per-turn diagnostic dumps — see docs/SOPHIE_AGENT.md)
runs/

# Data directory
data/
